# Empty template. start:local loads .env.local only when the user runs it.
# Configure new deployment secrets through the hosting provider, never chat.
PUBLIC_ORIGIN=http://127.0.0.1:4318
# Optional external MCP adapter settings; ignored by start:local.
AUTH_ISSUER=https://identity.example
AUTH_AUDIENCE=https://dashboard.example/mcp
AUTH_JWKS_URI=https://identity.example/.well-known/jwks.json
# New independent browser login configuration, never the private site client.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Independent YouTube read-only authorization configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=
